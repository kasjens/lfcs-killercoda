        },
        {
          "n": 4,
          "title": "service constraints",
          "sandbox": "user-ns",
          "setup": [
            "printf '[Unit]\\nDescription=hello\\n\\n[Service]\\nExecStart=/usr/bin/sleep 3600\\n' > /etc/systemd/system/hello.service"
          ],
          "solve": [
            "mkdir -p /etc/systemd/system/hello.service.d",
            "printf '[Service]\\nMemoryMax=512M\\nCPUQuota=20%%\\n' > /etc/systemd/system/hello.service.d/limits.conf"
          ]
        },
        {
          "n": 5,
          "title": "disk space",
          "sandbox": "user-ns",
          "setup": [
            "mkdir -p /srv/data",
            "dd if=/dev/zero of=/srv/data/archive.log bs=1M count=5 status=none",
            "echo 'small' > /srv/data/app.log",
            "echo 'notes' > /srv/data/notes.txt"
          ],
          "solve": [
            "rm -f /srv/data/archive.log"
          ]
        },
        {
          "n": 6,
          "title": "SSL certificate",
          "sandbox": "user-ns",
          "solve": [
            "mkdir -p /etc/ssl/private /etc/ssl/certs",
            "openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj '/CN=lfcs.example.com' -keyout /etc/ssl/private/lfcs.key -out /etc/ssl/certs/lfcs.crt >/dev/null 2>&1",
            "chmod 600 /etc/ssl/private/lfcs.key"
          ]
        }
