{
  "_comment": [
    "Source of truth for every question in the domain scenarios.",
    "tools/gen_verifiers.py turns this into each scenario's verify<step>.sh, and",
    "tests/test_questions.py asserts three separate things: the committed",
    "verifiers still match what the generator produces, the verifiers accept the",
    "canonical answer and reject the decoy, and the man page each question claims",
    "exists in the section claimed and really contains the term.",
    "",
    "Fields: n question number, step, subject shown on failure, answer canonical,",
    "accept other accepted spellings, cs case-sensitive, decoy a wrong answer that",
    "must be rejected, page the man page backing the answer, section expected",
    "section, contains a term the rendered page must include."
  ],
  "scenarios": {
    "essential-commands": {
      "title": "LFCS: Essential commands",
      "domain": "Essential Commands",
      "weight": "20%",
      "steps": [
        "Basic Git operations",
        "Create, configure and troubleshoot services",
        "Monitor and troubleshoot system performance",
        "Application and service specific constraints",
        "Troubleshoot disk space issues",
        "Work with SSL certificates"
      ],

      "tasks": [
        {"n": 1, "title": "git repository", "sandbox": "user-ns",
         "solve": [
           "mkdir -p /srv/app && cd /srv/app",
           "git init -q /srv/app",
           "git -C /srv/app config user.name 'LFCS Candidate'",
           "git -C /srv/app config user.email 'candidate@example.com'",
           "echo '# app' > /srv/app/README.md",
           "git -C /srv/app add README.md",
           "git -C /srv/app commit -q -m 'Add README'",
           "git -C /srv/app branch release"
         ]},
        {"n": 2, "title": "systemd unit", "sandbox": "user-ns",
         "solve": [
           "mkdir -p /etc/systemd/system/multi-user.target.wants",
           "printf '[Unit]\\nDescription=hello\\n\\n[Service]\\nType=simple\\nExecStart=/usr/bin/sleep 3600\\nRestart=on-failure\\nUser=deploy\\nWorkingDirectory=/srv/app\\n\\n[Install]\\nWantedBy=multi-user.target\\n' > /etc/systemd/system/hello.service",
           "ln -sf /etc/systemd/system/hello.service /etc/systemd/system/multi-user.target.wants/hello.service"
         ]},
        {"n": 3, "title": "performance collection", "sandbox": "user-ns",
         "setup": [
           "mkdir -p /etc/default",
           "printf 'ENABLED=\"false\"\\n' > /etc/default/sysstat"
         ],
         "solve": [
           "sed -i -E 's/^[[:space:]]*ENABLED[[:space:]]*=.*/ENABLED=\"true\"/' /etc/default/sysstat",
           "vmstat 1 3 > /root/vmstat.txt"
         ]},
        {"n": 4, "title": "service constraints", "sandbox": "user-ns",
         "setup": [
           "printf '[Unit]\\nDescription=hello\\n\\n[Service]\\nExecStart=/usr/bin/sleep 3600\\n' > /etc/systemd/system/hello.service"
         ],
         "solve": [
           "mkdir -p /etc/systemd/system/hello.service.d",
           "printf '[Service]\\nMemoryMax=512M\\nCPUQuota=20%%\\n' > /etc/systemd/system/hello.service.d/limits.conf"
         ]},
        {"n": 5, "title": "disk space", "sandbox": "user-ns",
         "setup": [
           "mkdir -p /srv/data",
           "dd if=/dev/zero of=/srv/data/archive.log bs=1M count=5 status=none",
           "echo 'small' > /srv/data/app.log",
           "echo 'notes' > /srv/data/notes.txt"
         ],
         "solve": ["rm -f /srv/data/archive.log"]},
        {"n": 6, "title": "SSL certificate", "sandbox": "user-ns",
         "solve": [
           "mkdir -p /etc/ssl/private /etc/ssl/certs",
           "openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj '/CN=lfcs.example.com' -keyout /etc/ssl/private/lfcs.key -out /etc/ssl/certs/lfcs.crt >/dev/null 2>&1",
           "chmod 600 /etc/ssl/private/lfcs.key"
         ]}
      ],

      "questions": []
    },

    "users-and-groups": {
      "title": "LFCS: Users and groups",
      "domain": "Users and Groups",
      "weight": "10%",
      "steps": [
        "Create and manage local user and group accounts",
        "Personal and system-wide environment profiles",
        "Configure user resource limits",
        "Configure and manage ACLs",
        "Use LDAP user and group accounts"
      ],

      "tasks": [
        {"n": 1, "title": "accounts", "sandbox": "user-ns",
         "solve": [
           "groupadd -g 4000 webops",
           "useradd -m -d /home/deploy -s /bin/bash -g webops deploy",
           "chage -E 2026-12-31 deploy"
         ]},
        {"n": 2, "title": "environment profiles", "sandbox": "user-ns",
         "solve": [
           "printf 'export EDITOR=vim\\n' > /etc/profile.d/lfcs.sh",
           "chmod 644 /etc/profile.d/lfcs.sh",
           "sed -i -E 's/^[[:space:]]*UMASK[[:space:]]+.*/UMASK\\t\\t027/' /etc/login.defs",
           "grep -qiE '^[[:space:]]*UMASK' /etc/login.defs || printf 'UMASK\\t\\t027\\n' >> /etc/login.defs"
         ]},
        {"n": 3, "title": "resource limits", "sandbox": "user-ns",
         "solve": [
           "mkdir -p /etc/security/limits.d",
           "printf 'deploy soft nofile 4096\\ndeploy hard nofile 8192\\n' > /etc/security/limits.d/deploy.conf"
         ]},
        {"n": 4, "title": "ACLs", "sandbox": "user-ns",
         "solve": [
           "groupadd -g 4000 webops",
           "useradd -M -g webops deploy",
           "mkdir -p /srv/webops",
           "chgrp webops /srv/webops",
           "chmod 2770 /srv/webops",
           "setfacl -m u:deploy:rwx /srv/webops",
           "setfacl -d -m u:deploy:rwx /srv/webops"
         ]}
      ],

      "questions": [
        {"n": 1, "step": 5, "subject": "the page deciding which sources answer passwd and group lookups",
         "answer": "nsswitch.conf", "accept": ["/etc/nsswitch.conf"], "decoy": "resolv.conf",
         "page": "nsswitch.conf", "section": "5", "contains": "passwd"},
        {"n": 2, "step": 5, "subject": "the section that page lives in",
         "answer": "5", "decoy": "8",
         "page": "nsswitch.conf", "section": "5"},
        {"n": 3, "step": 5, "subject": "the configuration page for the SSSD daemon",
         "answer": "sssd.conf", "accept": ["sssd.conf(5)"], "decoy": "nsswitch.conf",
         "page": "sssd.conf", "section": "5", "contains": "sssd"},
        {"n": 4, "step": 5, "subject": "the configuration page for the LDAP client library",
         "answer": "ldap.conf", "accept": ["ldap.conf(5)"], "decoy": "sssd.conf",
         "page": "ldap.conf", "section": "5", "contains": "ldap"}
      ]
    }
  }
}
