{
  "_comment": [
    "Source of truth for every question in the domain scenarios.",
    "tools/gen_verifiers.py turns this into each scenario's verify<step>.sh, and",
    "tests/test_questions.py asserts three separate things: the committed",
    "verifiers still match what the generator produces, the verifiers accept the",
    "canonical answer and reject the decoy, and the man page each question claims",
    "exists in the section claimed and really contains the term.",
    "",
    "Fields: n question number, step, subject shown on failure, answer canonical,",
    "accept other accepted spellings, cs case-sensitive, decoy a wrong answer that",
    "must be rejected, page the man page backing the answer, section expected",
    "section, contains a term the rendered page must include."
  ],
  "scenarios": {
    "essential-commands": {
      "title": "LFCS: Essential commands",
      "domain": "Essential Commands",
      "weight": "20%",
      "steps": [
        "Basic Git operations",
        "Create, configure and troubleshoot services",
        "Monitor and troubleshoot system performance",
        "Application and service specific constraints",
        "Troubleshoot disk space issues",
        "Work with SSL certificates"
      ],
      "questions": [
        {"n": 1, "step": 1, "subject": "the command that copies an existing repository",
         "answer": "git clone", "decoy": "git pull",
         "page": "git-clone", "section": "1", "contains": "git clone"},
        {"n": 2, "step": 1, "subject": "the command that records staged changes",
         "answer": "git commit", "decoy": "git add",
         "page": "git-commit", "section": "1", "contains": "git commit"},
        {"n": 3, "step": 1, "subject": "the command that shows the commit history",
         "answer": "git log", "decoy": "git status",
         "page": "git-log", "section": "1", "contains": "git log"},
        {"n": 4, "step": 1, "subject": "the man page name for the clone subcommand",
         "answer": "git-clone", "decoy": "git clone",
         "page": "git-clone", "section": "1"},

        {"n": 5, "step": 2, "subject": "the systemctl subcommand that rereads unit files after an edit",
         "answer": "daemon-reload", "accept": ["systemctl daemon-reload"], "decoy": "reload",
         "page": "systemctl", "section": "1", "contains": "daemon-reload"},
        {"n": 6, "step": 2, "subject": "the journalctl flag that limits output to one unit",
         "answer": "-u", "accept": ["--unit"], "cs": true, "decoy": "-U",
         "page": "journalctl", "section": "1", "contains": "--unit"},
        {"n": 7, "step": 2, "subject": "the page that documents Restart=",
         "answer": "systemd.service", "accept": ["systemd.service(5)"], "decoy": "systemd.exec",
         "page": "systemd.service", "section": "5", "contains": "Restart="},
        {"n": 8, "step": 2, "subject": "the systemctl subcommand showing a unit's state with recent log lines",
         "answer": "status", "accept": ["systemctl status"], "decoy": "show",
         "page": "systemctl", "section": "1", "contains": "status"},

        {"n": 9, "step": 3, "subject": "the command that reports virtual memory statistics",
         "answer": "vmstat", "decoy": "free",
         "page": "vmstat", "section": "8", "contains": "vmstat"},
        {"n": 10, "step": 3, "subject": "the section the vmstat page lives in",
         "answer": "8", "decoy": "1",
         "page": "vmstat", "section": "8"},
        {"n": 11, "step": 3, "subject": "the command that reports per-device I/O statistics",
         "answer": "iostat", "decoy": "iotop",
         "page": "iostat", "section": "1", "contains": "iostat"},
        {"n": 12, "step": 3, "subject": "the command that reports activity collected over time",
         "answer": "sar", "decoy": "sadf",
         "page": "sar", "section": "1", "contains": "sar"},

        {"n": 13, "step": 4, "subject": "the file setting per-user resource limits at login",
         "answer": "limits.conf", "accept": ["/etc/security/limits.conf"], "decoy": "sysctl.conf",
         "page": "limits.conf", "section": "5", "contains": "nofile"},
        {"n": 14, "step": 4, "subject": "the section man ulimit actually lands in",
         "answer": "3", "decoy": "1",
         "page": "ulimit", "section": "3"},
        {"n": 15, "step": 4, "subject": "the page documenting the shell builtin ulimit",
         "answer": "bash", "decoy": "ulimit",
         "page": "bash", "section": "1", "contains": "ulimit"},
        {"n": 16, "step": 4, "subject": "the page documenting CPUQuota= and MemoryMax=",
         "answer": "systemd.resource-control", "accept": ["systemd.resource-control(5)"],
         "decoy": "systemd.exec",
         "page": "systemd.resource-control", "section": "5", "contains": "CPUQuota="},

        {"n": 17, "step": 5, "subject": "the command reporting free space per filesystem",
         "answer": "df", "decoy": "du",
         "page": "df", "section": "1"},
        {"n": 18, "step": 5, "subject": "the command summarising space used by a directory tree",
         "answer": "du", "decoy": "df",
         "page": "du", "section": "1"},
        {"n": 19, "step": 5, "subject": "the command listing open files, including deleted ones still held open",
         "answer": "lsof", "decoy": "fuser",
         "page": "lsof", "section": "8", "contains": "deleted"},
        {"n": 20, "step": 5, "subject": "the section the lsof page lives in",
         "answer": "8", "decoy": "1",
         "page": "lsof", "section": "8"},

        {"n": 21, "step": 6, "subject": "the command suite for certificate operations",
         "answer": "openssl", "decoy": "certtool",
         "page": "openssl", "section": "1", "contains": "openssl"},
        {"n": 22, "step": 6, "subject": "the subcommand page for displaying and signing X.509 certificates",
         "answer": "openssl-x509", "accept": ["x509"], "decoy": "openssl-req",
         "page": "openssl-x509", "section": "1", "contains": "x509"},
        {"n": 23, "step": 6, "subject": "the command that rebuilds the system trust store",
         "answer": "update-ca-certificates", "decoy": "ca-certificates",
         "page": "update-ca-certificates", "section": "8", "contains": "ca-certificates"},
        {"n": 24, "step": 6, "subject": "the section update-ca-certificates lives in",
         "answer": "8", "decoy": "1",
         "page": "update-ca-certificates", "section": "8"}
      ]
    },

    "users-and-groups": {
      "title": "LFCS: Users and groups",
      "domain": "Users and Groups",
      "weight": "10%",
      "steps": [
        "Create and manage local user and group accounts",
        "Personal and system-wide environment profiles",
        "Configure user resource limits",
        "Configure and manage ACLs",
        "Use LDAP user and group accounts"
      ],

      "tasks": [
        {"n": 1, "title": "accounts", "sandbox": "user-ns",
         "solve": [
           "groupadd -g 4000 webops",
           "useradd -m -d /home/deploy -s /bin/bash -g webops deploy",
           "chage -E 2026-12-31 deploy"
         ]},
        {"n": 2, "title": "environment profiles", "sandbox": "user-ns",
         "solve": [
           "printf 'export EDITOR=vim\\n' > /etc/profile.d/lfcs.sh",
           "chmod 644 /etc/profile.d/lfcs.sh",
           "sed -i -E 's/^[[:space:]]*UMASK[[:space:]]+.*/UMASK\\t\\t027/' /etc/login.defs",
           "grep -qiE '^[[:space:]]*UMASK' /etc/login.defs || printf 'UMASK\\t\\t027\\n' >> /etc/login.defs"
         ]},
        {"n": 3, "title": "resource limits", "sandbox": "user-ns",
         "solve": [
           "mkdir -p /etc/security/limits.d",
           "printf 'deploy soft nofile 4096\\ndeploy hard nofile 8192\\n' > /etc/security/limits.d/deploy.conf"
         ]},
        {"n": 4, "title": "ACLs", "sandbox": "user-ns",
         "solve": [
           "groupadd -g 4000 webops",
           "useradd -M -g webops deploy",
           "mkdir -p /srv/webops",
           "chgrp webops /srv/webops",
           "chmod 2770 /srv/webops",
           "setfacl -m u:deploy:rwx /srv/webops",
           "setfacl -d -m u:deploy:rwx /srv/webops"
         ]}
      ],

      "questions": [
        {"n": 1, "step": 5, "subject": "the page deciding which sources answer passwd and group lookups",
         "answer": "nsswitch.conf", "accept": ["/etc/nsswitch.conf"], "decoy": "resolv.conf",
         "page": "nsswitch.conf", "section": "5", "contains": "passwd"},
        {"n": 2, "step": 5, "subject": "the section that page lives in",
         "answer": "5", "decoy": "8",
         "page": "nsswitch.conf", "section": "5"},
        {"n": 3, "step": 5, "subject": "the configuration page for the SSSD daemon",
         "answer": "sssd.conf", "accept": ["sssd.conf(5)"], "decoy": "nsswitch.conf",
         "page": "sssd.conf", "section": "5", "contains": "sssd"},
        {"n": 4, "step": 5, "subject": "the configuration page for the LDAP client library",
         "answer": "ldap.conf", "accept": ["ldap.conf(5)"], "decoy": "sssd.conf",
         "page": "ldap.conf", "section": "5", "contains": "ldap"}
      ]
    }
  }
}
